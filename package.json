{
  "name": "snake-3310",
  "version": "0.1.0",
  "private": true,
  "description": "Jogo da cobrinha do Nokia 3310 no navegador, com ranking público",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "build": "tsc -p src/tsconfig.build.json && vite build",
    "start": "node dist/server/interface/main.js",
    "migrar": "node dist/server/interface/migrate.js",
    "lint": "eslint . && node scripts/check-design.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web",
    "test": "npm run test:tooling && vitest run src tests/migracoes tests/empacotamento",
    "test:tooling": "node --test tests/scripts/*.native.mjs",
    "test:affected": "node scripts/affected-tests.mjs",
    "test:acceptance": "vitest run tests/aceite",
    "test:architecture": "depcruise src --config .dependency-cruiser.cjs",
    "test:coverage": "vitest run src --coverage",
    "test:migracoes": "vitest run tests/migracoes",
    "dev": "vite",
    "test:ui": "npm run build && node scripts/check-ui.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "pretest:acceptance": "node scripts/prepare-acceptance.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
